<!DOCTYPE html>
<html lang="{{ language }}">
<head>
  <meta charset="utf-8" />
  <title>{{ profile.identity.full_name }} — Resume</title>
  <style>
    @page {
      size: A4;
      margin: 10mm 12mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
      font-size: 9.6pt;
      line-height: 1.38;
      color: #111827;
      background: #ffffff;
    }
    header {
      border-bottom: 1.5px solid #059669;
      padding-bottom: 6px;
      margin-bottom: 8px;
    }
    h1 {
      font-size: 17pt;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #09090b;
    }
    .headline {
      font-size: 10.5pt;
      font-weight: 600;
      color: #047857;
      margin-top: 1px;
    }
    .contact {
      margin-top: 4px;
      font-size: 8.6pt;
      color: #3f3f46;
    }
    .contact a {
      color: #3f3f46;
      text-decoration: none;
    }
    section {
      margin-bottom: 8px;
    }
    h2 {
      font-size: 9.5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #047857;
      border-bottom: 1px solid #e4e4e7;
      padding-bottom: 2px;
      margin-bottom: 5px;
    }
    .summary {
      font-size: 9.4pt;
      color: #18181b;
    }
    .entry {
      margin-bottom: 6px;
    }
    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
    }
    .entry-title {
      font-weight: 700;
      font-size: 9.8pt;
      color: #09090b;
    }
    .entry-meta {
      font-size: 8.6pt;
      color: #52525b;
      white-space: nowrap;
    }
    .entry-sub {
      font-size: 8.8pt;
      color: #52525b;
      margin-bottom: 2px;
    }
    ul {
      padding-left: 14px;
    }
    li {
      margin-bottom: 2px;
      font-size: 9.2pt;
    }
    .skill-row {
      margin-bottom: 2px;
      font-size: 9.1pt;
    }
    .skill-cat {
      font-weight: 700;
      color: #09090b;
    }
  </style>
</head>
<body>
  <header>
    <h1>{{ profile.identity.full_name }}</h1>
    <div class="headline">{{ headline }}</div>
    <div class="contact">
      {{ contact_line }}
    </div>
  </header>

  {% if summary %}
  <section>
    <h2>{{ labels.summary }}</h2>
    <p class="summary">{{ summary }}</p>
  </section>
  {% endif %}

  {% if experiences %}
  <section>
    <h2>{{ labels.experience }}</h2>
    {% for exp in experiences %}
    <div class="entry">
      <div class="entry-header">
        <span class="entry-title">{{ exp.role }} — {{ exp.company }}</span>
        <span class="entry-meta">{{ exp.start_date }} – {{ exp.end_date }}</span>
      </div>
      {% if exp.location %}
      <div class="entry-sub">{{ exp.location }}</div>
      {% endif %}
      <ul>
        {% for b in exp.bullets %}
        <li>{{ b }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if skill_groups %}
  <section>
    <h2>{{ labels.skills }}</h2>
    {% for grp in skill_groups %}
    <div class="skill-row">
      <span class="skill-cat">{{ grp.category }}:</span> {{ grp.skills | join(", ") }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if profile.education %}
  <section>
    <h2>{{ labels.education }}</h2>
    {% for edu in profile.education %}
    <div class="entry">
      <div class="entry-header">
        <span class="entry-title">{{ edu.institution }}{% if edu.degree %} — {{ edu.degree }}{% endif %}</span>
        <span class="entry-meta">{{ edu.start_date }}{% if edu.end_date %} – {{ edu.end_date }}{% endif %}</span>
      </div>
      {% if edu.highlights %}
      <ul>
        {% for h in edu.highlights %}
        <li>{{ h }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if profile.languages %}
  <section>
    <h2>{{ labels.languages }}</h2>
    <div class="skill-row">
      {% for lang_item in profile.languages %}
      <span><strong>{{ lang_item.language }}:</strong> {{ lang_item.proficiency }}{% if not loop.last %} &nbsp;•&nbsp; {% endif %}</span>
      {% endfor %}
    </div>
  </section>
  {% endif %}
</body>
</html>
